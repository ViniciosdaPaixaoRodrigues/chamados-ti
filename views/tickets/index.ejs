<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chamados — HelpDesk TI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard-profile.css">
</head>
<body>
  <div class="bg-glow" aria-hidden="true"></div>

  <div class="app">
    <!-- BARRA LATERAL -->
    <aside class="sidebar">
      <a href="/dashboard" class="brand" id="brand-link">
        <span class="brand-logo">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </span>
        <span class="brand-text">HelpDesk<strong>TI</strong></span>
      </a>

      <nav class="nav" aria-label="Navegação principal">
        <span class="nav-label">Geral</span>
        <a href="/dashboard" id="nav-dashboard" class="nav-link">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
          <span>Dashboard</span>
        </a>
        <a href="/tickets" id="nav-tickets" class="nav-link active">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
          <span>Chamados</span>
        </a>

        <!-- Seção visível exclusivamente para Administradores -->
        <div id="adminNavSection" style="display: none;">
          <span class="nav-label">Administração</span>
          <a href="/usuarios" id="nav-usuarios" class="nav-link">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Gestão de Usuários</span>
          </a>
        </div>
      </nav>

      <a href="/tickets/novo" class="btn btn-primary btn-block sidebar-cta" id="sidebar-new-ticket">
        <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Novo chamado
      </a>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main">
      <header class="page-header">
        <div>
          <p class="eyebrow">Atendimento</p>
          <h1>Chamados</h1>
          <p class="subtitle" id="ticketsSubtitle">Carregando...</p>
        </div>
        <div>
          <a href="/tickets/novo" class="btn btn-primary">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Novo chamado
          </a>
        </div>
      </header>

      <!-- ABAS DE FILTRO POR STATUS -->
      <nav class="tabs" aria-label="Filtro rápido por status">
        <a href="#" class="tab active" id="tab-todos" data-status="">Todos</a>
        <a href="#" class="tab" data-status="ativos">Em aberto</a>
        <a href="#" class="tab" data-status="aberto"><span class="dot" style="background: var(--blue);"></span>Aberto</a>
        <a href="#" class="tab" data-status="em_andamento"><span class="dot" style="background: var(--amber);"></span>Em andamento</a>
        <a href="#" class="tab" data-status="resolvido"><span class="dot" style="background: var(--green);"></span>Resolvido</a>
      </nav>

      <!-- BARRA DE FILTROS -->
      <div class="filters card">
        <div class="search">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="filter-q" placeholder="Buscar por título, solicitante ou protocolo…" aria-label="Buscar">
        </div>
        <select id="filter-prioridade" aria-label="Prioridade">
          <option value="">Todas prioridades</option>
          <option value="baixa">Baixa</option>
          <option value="media">Média</option>
          <option value="alta">Alta</option>
          <option value="critica">Crítica</option>
        </select>
        <button type="button" class="btn btn-ghost" id="filter-clear">Limpar filtros</button>
      </div>

      <!-- TABELA DE CHAMADOS -->
      <section class="card card-flush">
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Protocolo</th>
                <th>Chamado</th>
                <th>Categoria</th>
                <th>Prioridade</th>
                <th>Status</th>
                <th>Responsável</th>
                <th>Data</th>
              </tr>
            </thead>
            <tbody id="ticketsTableBody">
              <tr>
                <td colspan="7" class="muted" style="text-align: center; padding: 32px;">
                  Carregando chamados do Firebase...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <!-- FIREBASE SCRIPTS (COMPAT) -->
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>

  <!-- LÓGICA DE LISTAGEM DE CHAMADOS -->
  <script src="/js/tickets.js"></script>
</body>
</html>
