<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Novo Chamado — HelpDesk TI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard-profile.css">
</head>
<body>
  <div class="bg-glow" aria-hidden="true"></div>

  <div class="app">
    <!-- BARRA LATERAL -->
    <aside class="sidebar">
      <a href="/dashboard" class="brand" id="brand-link">
        <span class="brand-logo">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </span>
        <span class="brand-text">HelpDesk<strong>TI</strong></span>
      </a>

      <nav class="nav" aria-label="Navegação principal">
        <span class="nav-label">Geral</span>
        <a href="/dashboard" id="nav-dashboard" class="nav-link">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
          <span>Dashboard</span>
        </a>
        <a href="/tickets" id="nav-tickets" class="nav-link">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
          <span>Chamados</span>
        </a>

        <!-- Seção visível exclusivamente para Administradores -->
        <div id="adminNavSection" style="display: none;">
          <span class="nav-label">Administração</span>
          <a href="/usuarios" id="nav-usuarios" class="nav-link">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Gestão de Usuários</span>
          </a>
        </div>
      </nav>

      <a href="/tickets/novo" class="btn btn-primary btn-block sidebar-cta active" id="sidebar-new-ticket">
        <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Novo chamado
      </a>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main">
      <header class="page-header">
        <div>
          <a href="/tickets" class="back-link">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Chamados
          </a>
          <h1>Abrir Novo Chamado</h1>
          <p class="subtitle">Descreva o problema com clareza para que a equipe técnica possa atendê-lo.</p>
        </div>
      </header>

      <form onsubmit="handleCreateTicket(event)" class="form-layout" id="ticket-form">
        <!-- DETALHES DO CHAMADO -->
        <section class="card">
          <h2 class="form-section">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/></svg>
            Informações do Problema
          </h2>

          <div class="field">
            <label for="titulo">Título do chamado <span class="req">*</span></label>
            <input type="text" id="titulo" maxlength="150" placeholder="Ex.: Monitor não liga ou VPN instável" required autofocus>
          </div>

          <div class="field">
            <label for="categoria">Categoria do serviço</label>
            <select id="categoria">
              <option value="Hardware">Hardware (Computador, Impressora, Monitor)</option>
              <option value="Software">Software & Aplicativos</option>
              <option value="Rede & Internet">Rede & Internet / Wi-Fi</option>
              <option value="Acessos & Senhas">Acessos & Senhas de Sistemas</option>
              <option value="Telefonia">Telefonia & Ramais</option>
              <option value="Outros">Outros assuntos</option>
            </select>
          </div>

          <div class="field">
            <label for="descricao">Descrição detalhada <span class="req">*</span></label>
            <textarea id="descricao" rows="6" placeholder="Explique o que aconteceu, desde quando ocorre e mensagens de erro exibidas..." required></textarea>
          </div>

          <fieldset class="field">
            <legend>Nível de Urgência / Prioridade</legend>
            <div class="segmented">
              <label class="seg seg-gray">
                <input type="radio" name="prioridade" value="baixa">
                <span>Baixa</span>
              </label>
              <label class="seg seg-blue">
                <input type="radio" name="prioridade" value="media" checked>
                <span>Média</span>
              </label>
              <label class="seg seg-amber">
                <input type="radio" name="prioridade" value="alta">
                <span>Alta</span>
              </label>
              <label class="seg seg-red">
                <input type="radio" name="prioridade" value="critica">
                <span>Crítica</span>
              </label>
            </div>
          </fieldset>
        </section>

        <!-- BARRA LATERAL DO FORMULÁRIO -->
        <aside>
          <section class="card">
            <h2 class="form-section">Conclusão</h2>
            <p class="muted" style="font-size: 13px; line-height: 1.5; margin-bottom: 16px;">
              Ao clicar no botão abaixo, o chamado será registrado na fila e atribuído ao seu usuário.
            </p>
            <button type="submit" class="btn btn-primary btn-block" id="btnSubmitTicket">
              Abrir chamado
            </button>
            <a href="/tickets" class="btn btn-ghost btn-block" style="margin-top: 8px; text-align: center;">
              Cancelar
            </a>
          </section>
        </aside>
      </form>
    </main>
  </div>

  <!-- FIREBASE SCRIPTS (COMPAT) -->
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>

  <!-- LÓGICA DE ABERTURA DE CHAMADO -->
  <script src="/js/ticket-new.js"></script>
</body>
</html>
